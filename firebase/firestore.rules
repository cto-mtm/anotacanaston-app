rules_version = '2';

// Anota Canaston — Firestore security rules.
//
// Model:
//   users/{uid}                     — one doc per user; holds billing entitlement
//   users/{uid}/sessions/{sessionId} — the user's synced game sessions
//
// A user may read only their own sessions, and write them only while their
// Club entitlement is active — cloud storage is the paid feature, so the
// paywall is enforced here, not just in the app. Reads stay open to the owner
// so a lapsed subscriber can still pull their data down.
//
// The user document itself is READ-only to the client: the `cloudSync`
// entitlement is written exclusively by the Stripe webhook Cloud Function
// (which uses the Admin SDK and bypasses these rules), so a client can never
// grant itself Club access.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasCloudSync(uid) {
      let user = /databases/$(database)/documents/users/$(uid);
      return exists(user) && get(user).data.get('cloudSync', false) == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // No client writes — entitlement is server-controlled.
      allow write: if false;

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasCloudSync(uid);
      }

      // Synced app settings (e.g. the group's house rules). Same paywall.
      match /settings/{settingId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasCloudSync(uid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
