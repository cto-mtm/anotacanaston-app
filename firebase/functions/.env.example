# Functions env values (non-secret). Firebase loads them into process.env:
#   .env.anotacanaston-app  — production deploys (committed; Stripe LIVE product)
#   .env.local              — the emulator only (git-ignored; copy this file)
#
# For local billing tests, point the emulator at Stripe TEST mode:
#   1. In the Stripe dashboard (test mode), create a "Canastón Premium" product
#      with a recurring default price, and paste its id below.
#   2. Put the test-mode secrets in functions/.secret.local (also git-ignored):
#        STRIPE_SECRET=sk_test_...
#        STRIPE_WEBHOOK_SECRET=whsec_...   (from `stripe listen`)

STRIPE_PRODUCT_ID=prod_your_test_mode_product_id
