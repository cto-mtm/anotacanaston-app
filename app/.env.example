VITE_API_URL=http://127.0.0.1:5001/demo-app/us-central1/api

# Firebase web app config — from Firebase console → Project settings → Your apps
# → SDK setup and configuration. Keep these commented out for local emulator
# dev: the app only falls back to the offline `demo-app` project when they're
# unset, and the emulators write entitlements under `demo-app`.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
